# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Vector database
QDRANT_URL=
QDRANT_API_KEY=
# Local embedded Qdrant path (optional; tests use :memory:)
# QDRANT_PATH=

# Ingestion / dedup
# CHUNK_STRATEGY=structure_aware
# SIMHASH_THRESHOLD=3
# NEAR_DUPLICATE_POLICY=flag
# UPLOAD_MAX_BYTES=10485760

# PostgreSQL
DATABASE_URL=

# Admin authentication
ADMIN_TOKEN=

# Optional: override default model IDs
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings (candidate; do not enable at startup on Render until Linux RSS confirmed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_ENABLED_AT_STARTUP=false
# FASTEMBED_CACHE_PATH=

# Retrieval / hybrid (Phase 3)
# N_DENSE=50
# N_SPARSE=50
# RRF_K=60
# FUSION_ALPHA=0.5
# BM25_K1=1.2
# BM25_B=0.75
# BM25_AVGDL=100
# PER_DOC_CAP=3

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

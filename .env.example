# LLM providers (free tiers only; never commit real keys)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override default model IDs (verified 2026-10-29)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_ALT_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# LLM / investigation budgets (Phase 4)
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_S=0.5
# LLM_RETRY_MAX_S=8
# LLM_BUDGET_MAX_CALLS=20
# LLM_BUDGET_MAX_TOKENS=50000
# LLM_BUDGET_WALL_CLOCK_S=120
# MAX_TOOL_ROUNDS=6
# MAX_SUB_QUESTIONS=4
# MAX_QUESTION_CHARS=2000
# TAU_RETRIEVAL=0
# RETRIEVAL_TOP_K=8
# INJECTION_DOWNWEIGHT=0.05

# Vector database
QDRANT_URL=
QDRANT_API_KEY=
# Local embedded Qdrant path (optional; tests use :memory:)
# QDRANT_PATH=

# Ingestion / dedup
# CHUNK_STRATEGY=structure_aware
# SIMHASH_THRESHOLD=3
# NEAR_DUPLICATE_POLICY=flag
# UPLOAD_MAX_BYTES=10485760

# PostgreSQL (Neon). Bare postgresql:// is auto-rewritten to postgresql+psycopg://
# (Psycopg 3). Do not use psycopg2 — it is not installed.
DATABASE_URL=

# Admin authentication (mutating document endpoints)
ADMIN_TOKEN=

# API rate limits (Phase 5)
# QUERY_RATE_PER_MIN=30
# QUERY_BURST=10
# LLM_DAILY_CAP=0


# Embeddings (candidate; do not enable at startup on Render until Linux RSS confirmed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_ENABLED_AT_STARTUP=false
# FASTEMBED_CACHE_PATH=

# Retrieval / hybrid (Phase 3)
# N_DENSE=50
# N_SPARSE=50
# RRF_K=60
# FUSION_ALPHA=0.5
# BM25_K1=1.2
# BM25_B=0.75
# BM25_AVGDL=100
# PER_DOC_CAP=3

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

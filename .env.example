# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Vector database
QDRANT_URL=
QDRANT_API_KEY=
# Local embedded Qdrant path (optional; tests use :memory:)
# QDRANT_PATH=

# Ingestion / dedup
# CHUNK_STRATEGY=structure_aware
# SIMHASH_THRESHOLD=3
# NEAR_DUPLICATE_POLICY=flag
# UPLOAD_MAX_BYTES=10485760

# PostgreSQL
DATABASE_URL=

# Admin authentication
ADMIN_TOKEN=

# Optional: override default model IDs
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings (candidate; do not enable at startup on Render until Linux RSS confirmed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_ENABLED_AT_STARTUP=false

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
